{
  "name": "monitor-theme-boxpro",
  "version": "0.2.9",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "MONITOR_DEMO=1 vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build --logLevel warn",
    "preview": "vite preview --host 127.0.0.1",
    "package": "npm run build && node scripts/package.mjs",
    "verify:package": "python3 scripts/verify-package.py"
  },
  "dependencies": {
    "country-flag-icons": "^1.6.20",
    "globe.gl": "^2.46.1",
    "simple-icons": "^16.32.0",
    "three": "^0.184.0",
    "vue": "^3.5.28",
    "@lucide/vue": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.2.4"
  }
}
