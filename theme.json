    },
    {
      "key": "show_personal_finance",
      "type": "boolean",
      "label": "启用个人价值计算器",
      "default": true,
      "help": "显示右上角钱袋入口，并允许点击剩余价值卡片打开。支持搜索、分组筛选、勾选机器和月均费用计算；个人选择不改变公开汇总，遵守费用显隐设置。"
    },
    {
      "key": "hide_price_logged_out",
      "type": "boolean",
      "label": "对未登录访客隐藏费用",
      "default": false,
      "help": "开启后仅向已登录用户展示节点费用、剩余价值和个人计算器，且需要开启「显示费用」。只控制主题展示，不改变 Monitor 接口权限。"
    },
    {
      "key": "hide_admin",
      "type": "boolean",
      "label": "对未登录访客隐藏后台入口",
      "default": false,
      "help": "隐藏首页右上角的后台管理入口，已登录用户仍可见；不改变 /admin 的登录要求或主控权限。"
    },
    {
      "type": "title",
